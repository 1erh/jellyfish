#!/usr/bin/env python3
"""Print one waybar workspace button for a monitor."""
import json
import subprocess
import sys

output, workspace, label = sys.argv[1], sys.argv[2], sys.argv[3]


def hypr(what):
    try:
        return json.loads(subprocess.check_output(["hyprctl", what, "-j"]))
    except (subprocess.CalledProcessError, json.JSONDecodeError):
        return []


active = ""
for monitor in hypr("monitors"):
    if monitor.get("name") == output:
        active = str(monitor.get("activeWorkspace", {}).get("name", ""))
        break

windows = 0
for ws in hypr("workspaces"):
    if str(ws.get("name")) == workspace:
        windows = ws.get("windows", 0)
        break

if active == workspace:
    state = "active"
elif windows:
    state = "occupied"
else:
    state = "idle"

print(json.dumps({
    "text": label,
    "class": state,
    "tooltip": f"ワークスペース {label}" + (f" · {windows} 個のウィンドウ" if windows else ""),
}))
