#!/usr/bin/env python3
"""Minimize a window onto a special workspace, and bring it back.

The bar reads the same record so a minimized window stays listed on the
workspace it came from.
"""
import fcntl
import json
import os
import subprocess
import sys
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
STATE = RUNTIME / "hypr-minimized.json"
LOCK = RUNTIME / "hypr-minimized.lock"


def hypr(*args):
    out = subprocess.run(["hyprctl", *args], text=True, capture_output=True)
    if out.returncode != 0:
        return None
    if args and args[-1] == "-j":
        try:
            return json.loads(out.stdout)
        except json.JSONDecodeError:
            return None
    return out.stdout


def clients():
    found = hypr("clients", "-j")
    return found if isinstance(found, list) else []


def load():
    try:
        data = json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def save(data):
    STATE.write_text(json.dumps(data, ensure_ascii=False))


def prune(data, windows):
    alive = {win["address"] for win in windows if win.get("workspace", {}).get("name") == "special:minimized"}
    return {addr: info for addr, info in data.items() if addr in alive}


def signal_bar():
    subprocess.run(["pkill", "-RTMIN+10", "-x", "waybar"], check=False)


def dispatch(expr):
    subprocess.run(["hyprctl", "dispatch", expr], check=False)


def minimize(address):
    windows = clients()
    win = next((item for item in windows if item.get("address") == address), None)
    if not win:
        return
    workspace = win.get("workspace") or {}
    if workspace.get("name") == "special:minimized":
        return
    data = prune(load(), windows)
    data[address] = {
        "workspace": str(workspace.get("id", "")),
        "title": win.get("title") or win.get("class") or "ウィンドウ",
        "class": win.get("class") or "",
    }
    save(data)
    dispatch(
        "hl.dsp.window.move({ workspace = 'special:minimized', follow = false, "
        f"window = 'address:{address}' }})"
    )
    signal_bar()


def restore(address, workspace):
    data = load()
    data.pop(address, None)
    save(prune(data, clients()))
    dispatch(
        "hl.dsp.window.move({ "
        f"workspace = '{workspace}', follow = true, window = 'address:{address}' }})"
    )
    signal_bar()


def restore_last():
    windows = clients()
    data = prune(load(), windows)
    if not data:
        save(data)
        return
    address = next(reversed(data))
    workspace = data[address].get("workspace") or ""
    if not workspace:
        return
    here = hypr("activewindow", "-j")
    if isinstance(here, dict):
        current = here.get("workspace") or {}
        if not current.get("name", "").startswith("special:") and current.get("id") is not None:
            workspace = str(current.get("id"))
    restore(address, workspace)


def active_address():
    win = hypr("activewindow", "-j")
    if not isinstance(win, dict):
        return ""
    return win.get("address") or ""


def main():
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        cmd = sys.argv[1] if len(sys.argv) > 1 else ""
        if cmd == "minimize":
            address = sys.argv[2] if len(sys.argv) > 2 else active_address()
            if address:
                minimize(address)
        elif cmd == "restore-last":
            restore_last()
        elif cmd == "restore" and len(sys.argv) >= 4:
            restore(sys.argv[2], sys.argv[3])
        else:
            raise SystemExit("usage: window-min minimize [ADDRESS] | restore-last | restore ADDRESS WORKSPACE")


if __name__ == "__main__":
    main()
