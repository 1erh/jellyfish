def palette(id, label, keywords, ink, cream, text, text2, text3, muted, icon, fail, attention, light=False):
    return {
        "id": id, "label": label, "keywords": keywords,
        "ink": ink, "cream": cream, "text": text, "text2": text2, "text3": text3,
        "muted": muted, "icon": icon, "occupied": text2, "fail": fail,
        "tooltip": text, "attention": attention, "light": light,
    }


THEMES += [
