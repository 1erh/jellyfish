import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
HYPR = HOME / ".config/hypr"
WAYBAR = HOME / ".config/waybar/style.css"
WAYBAR_TEMPLATE = HOME / ".config/waybar/style.css.template"
SWAYNC = HOME / ".config/swaync/style.css"
HYPRLOCK = HYPR / "hyprlock.conf"
HYPRLAND = HYPR / "hyprland.lua"
THEME_FILE = HYPR / "theme.json"

