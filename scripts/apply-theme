def rgb(hex_color):
    h = hex_color.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def css_rgba(hex_color, alpha):
    r, g, b = rgb(hex_color)
    text = f"{alpha:.2f}".rstrip("0").rstrip(".")
    return f"rgba({r}, {g}, {b}, {text})"


def qml_argb(hex_color, alpha):
    r, g, b = rgb(hex_color)
    return f"#{round(alpha * 255):02x}{r:02x}{g:02x}{b:02x}"


def derived(theme):
    ink, cream, text = theme["ink"], theme["cream"], theme["text"]
    light = theme["light"]
    wash = "#000000" if light else "#ffffff"
    return {
        "ink": ink,
        "cream": cream,
        "text": text,
        "text2": theme["text2"],
        "text3": theme["text3"],
        "muted": theme["muted"],
        "icon": theme["icon"],
        "occupied": theme["occupied"],
        "fail": theme["fail"],
        "tooltip": theme["tooltip"],
        "hairline": css_rgba(cream, 0.16),
        "hairlineStrong": css_rgba(cream, 0.55),
        "hover": css_rgba(wash, 0.06),
        "barEdge": css_rgba(wash, 0.08 if light else 0.07),
        "tooltipBg": css_rgba(ink, 0.96),
        "panel": css_rgba(ink, 0.94),
        "card": css_rgba(wash, 0.04),
        "cardHover": css_rgba(wash, 0.08),
        "track": css_rgba(wash, 0.10),
        "attention": css_rgba(theme["attention"], 0.18),
        "notiBg": ", ".join(str(c) for c in rgb(ink)),
        "qmlHairline": qml_argb(cream, 0.16),
        "qmlPanel": qml_argb(ink, 0.94),
        "qmlHover": qml_argb(wash, 0.06),
    }


def render_waybar(colors):
    template = WAYBAR_TEMPLATE.read_text()
    out = template
    for key, value in colors.items():
        token = "{{" + key + "}}"
        if token in out:
            out = out.replace(token, value)
    leftover = re.findall(r"\{\{[a-zA-Z0-9]+\}\}", out)
    if leftover:
        raise SystemExit(f"unfilled waybar tokens: {leftover}")
    WAYBAR.write_text(out)


def render_swaync(colors):
    text = SWAYNC.read_text()
    block = f"""/* @theme */
:root {{
  --panel: {colors['panel']};
  --card: {colors['card']};
  --card-hover: {colors['cardHover']};
  --hairline: {colors['hairline']};
  --hairline-strong: {colors['hairlineStrong']};
  --cream: {colors['cream']};
  --ink: {colors['ink']};
  --text: {colors['text']};
  --text-2: {colors['text2']};
  --text-3: {colors['text3']};
  --fail: {colors['fail']};
  --track: {colors['track']};

  --cc-bg: var(--panel);
  --noti-border-color: var(--hairline);
  --noti-bg: {colors['notiBg']};
  --noti-bg-alpha: 0.94;
  --noti-bg-darker: transparent;
  --noti-bg-hover: var(--card-hover);
  --noti-bg-focus: transparent;
  --noti-close-bg: transparent;
  --noti-close-bg-hover: var(--track);
  --text-color: var(--text);
  --text-color-disabled: var(--text-3);
  --bg-selected: var(--cream);
  --border-radius: 0;
  --notification-shadow: none;
  --notification-icon-size: 40px;
  --font-size-body: 13px;
  --font-size-summary: 13.5px;
}}
/* @theme-end */
"""
    updated, n = re.subn(r"/\* @theme \*/.*?/\* @theme-end \*/\n", block, text, count=1, flags=re.S)
    if n != 1:
        raise SystemExit("swaync theme markers missing")
    SWAYNC.write_text(updated)


def render_hyprlock(theme, colors):
    text = HYPRLOCK.read_text()
    tr, tg, tb = rgb(theme["text"])
    t2 = rgb(theme["text2"])
    replacements = {
        "bg": css_rgba(theme["ink"], 1),
        "text": css_rgba(theme["text"], 1),
        "text2": f"rgba({t2[0]}, {t2[1]}, {t2[2]}, 1)",
        "inner": css_rgba(theme["ink"], 0.88),
        "outer": css_rgba(theme["cream"], 0.20),
        "check": css_rgba(theme["text"], 0.45),
        "fail": css_rgba(theme["fail"], 0.9),
        "font": f"rgb({tr}, {tg}, {tb})",
    }
    for key, value in replacements.items():
        text, n = re.subn(
            rf"(# theme:{key}\n\s*[a-z_]+\s*=\s*)(?:rgba|rgb)\([^)]+\)",
            lambda m, value=value: m.group(1) + value,
            text,
        )
        if n < 1:
            raise SystemExit(f"hyprlock marker missing: {key}")
    markup = {
        "placeholder": theme["text3"].lstrip("#"),
        "failtext": theme["fail"].lstrip("#"),
    }
    for key, value in markup.items():
        text, n = re.subn(
            rf'(# theme:{key}\n\s*[a-z_]+\s*=\s*<span foreground=")##[0-9a-fA-F]{{6}}',
            lambda m, value=value: m.group(1) + "##" + value,
            text,
            count=1,
        )
        if n != 1:
            raise SystemExit(f"hyprlock marker missing: {key}")
    HYPRLOCK.write_text(text)


def render_hyprland(theme):
    text = HYPRLAND.read_text()
    cream = theme["cream"].lstrip("#")
    ink = theme["ink"].lstrip("#")
    text, n1 = re.subn(r'active_border = "rgba\([0-9a-fA-F]+\)"', f'active_border = "rgba({cream}ee)"', text, count=1)
    text, n2 = re.subn(r'inactive_border = "rgba\([0-9a-fA-F]+\)"', f'inactive_border = "rgba({cream}22)"', text, count=1)
    text, n3 = re.subn(r'background_color = "rgb\([0-9a-fA-F]+\)"', f'background_color = "rgb({ink})"', text, count=1)
    if n1 != 1 or n2 != 1 or n3 != 1:
        raise SystemExit("hyprland color fields missing")
    HYPRLAND.write_text(text)


def write_theme_file(current):
    public = []
    for theme in THEMES:
        colors = derived(theme)
        public.append({
            "id": theme["id"],
            "label": theme["label"],
            "keywords": theme["keywords"],
            "ink": theme["ink"],
            "cream": theme["cream"],
            "text": theme["text"],
            "text2": theme["text2"],
            "text3": theme["text3"],
            "hairline": colors["qmlHairline"],
            "panel": colors["qmlPanel"],
            "hover": colors["qmlHover"],
            "fail": theme["fail"],
        })
    THEME_FILE.write_text(json.dumps({"current": current, "themes": public}, ensure_ascii=False, indent=2) + "\n")


def reload():
    subprocess.run(["hyprctl", "reload"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["swaync-client", "-rs"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["pkill", "-USR2", "-x", "waybar"], check=False)


def main():
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        print("usage: apply-theme " + "|".join(t["id"] for t in THEMES))
        return 2 if len(sys.argv) != 2 else 0
    name = sys.argv[1].lower()
    theme = next((t for t in THEMES if t["id"] == name), None)
    if theme is None:
        print(f"unknown theme: {name}", file=sys.stderr)
        return 1
    colors = derived(theme)
    render_waybar(colors)
    render_swaync(colors)
    render_hyprlock(theme, colors)
    render_hyprland(theme)
    write_theme_file(theme["id"])
    reload()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
