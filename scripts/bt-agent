#!/usr/bin/env python3
"""BlueZ pairing agent for the Bluetooth panel.

Pairing requests are accepted only while an adapter is discovering, which the shell
does only while its Bluetooth panel is open; anything else is rejected. Codes that
must be typed on the other device are shown as a notification.
"""
import fcntl
import os
import subprocess

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

AGENT_PATH = "/org/hypr/bt_agent"
AGENT_IFACE = "org.bluez.Agent1"

lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "bt-agent.lock"), "w")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(0)


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


def device_props(bus, path):
    obj = bus.get_object("org.bluez", path)
    return obj.GetAll("org.bluez.Device1", dbus_interface="org.freedesktop.DBus.Properties")


def device_name(bus, path):
    try:
        p = device_props(bus, path)
        return str(p.get("Alias") or p.get("Address") or path)
    except dbus.DBusException:
        return str(path)


def pairing_window_open(bus):
    manager = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager")
    for ifaces in manager.GetManagedObjects().values():
        adapter = ifaces.get("org.bluez.Adapter1")
        if adapter and adapter.get("Discovering"):
            return True
    return False


def notify(summary, body):
    subprocess.Popen(["notify-send", "-a", "Bluetooth", summary, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Agent(dbus.service.Object):
    def __init__(self, bus):
        super().__init__(bus, AGENT_PATH)
        self.bus = bus

    def require_window(self):
        if not pairing_window_open(self.bus):
            raise Rejected("pairing is only accepted while the Bluetooth panel is open")

    @dbus.service.method(AGENT_IFACE, in_signature="", out_signature="")
    def Release(self):
        pass

    @dbus.service.method(AGENT_IFACE, in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        try:
            p = device_props(self.bus, device)
        except dbus.DBusException:
            raise Rejected("unknown device")
        if not (p.get("Paired") or p.get("Trusted")):
            raise Rejected("device is not paired")

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        self.require_window()
        notify("Bluetooth ペアリング", f"{device_name(self.bus, device)} に PIN 0000 を使用します")
        return "0000"

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        self.require_window()
        return dbus.UInt32(0)

    @dbus.service.method(AGENT_IFACE, in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        if entered == 0:
            notify("Bluetooth ペアリング", f"{device_name(self.bus, device)} で {passkey:06d} を入力して Enter")

    @dbus.service.method(AGENT_IFACE, in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        notify("Bluetooth ペアリング", f"{device_name(self.bus, device)} で {pincode} を入力して Enter")

    @dbus.service.method(AGENT_IFACE, in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        self.require_window()
        notify("Bluetooth ペアリング", f"{device_name(self.bus, device)} · コード {passkey:06d}")

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        self.require_window()

    @dbus.service.method(AGENT_IFACE, in_signature="", out_signature="")
    def Cancel(self):
        pass


def register(bus):
    manager = dbus.Interface(bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1")
    manager.RegisterAgent(AGENT_PATH, "KeyboardDisplay")
    manager.RequestDefaultAgent(AGENT_PATH)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    Agent(bus)

    def try_register():
        try:
            register(bus)
        except dbus.DBusException:
            return True
        return False

    # bluetoothd may start later or restart; register again whenever it appears.
    bus.watch_name_owner("org.bluez", lambda owner: owner and GLib.timeout_add(500, try_register))
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
