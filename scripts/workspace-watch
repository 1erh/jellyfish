#!/usr/bin/env python3
"""Refresh the bar when the workspace or its windows change.

Hyprland emits several lines for one switch. They are folded into a single
update so Waybar is not asked to redraw over and over.
"""
import fcntl
import glob
import os
import socket
import subprocess

lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "workspace-watch.lock")
lock = open(lock_path, "w")
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(0)

PUBLISH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "bar-tasks")
INTERESTING = (
    b"workspace>>", b"focusedmon>>", b"createworkspace>>", b"destroyworkspace>>",
    b"moveworkspace>>", b"openwindow>>", b"closewindow>>", b"movewindow>>",
)


def socket_path():
    found = glob.glob(f"/run/user/{os.getuid()}/hypr/*/.socket2.sock")
    if not found:
        raise SystemExit("hyprland event socket not found")
    return found[0]


def refresh():
    subprocess.run([PUBLISH, "publish"], check=False)


def take(buf):
    hit = False
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        if line.startswith(INTERESTING):
            hit = True
    return buf, hit


sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect(socket_path())
refresh()
buf = b""
while True:
    data = sock.recv(8192)
    if not data:
        break
    buf += data
    buf, hit = take(buf)
    if not hit:
        continue
    sock.settimeout(0.04)
    try:
        while True:
            more = sock.recv(8192)
            if not more:
                break
            buf += more
            buf, _ = take(buf)
    except TimeoutError:
        pass
    sock.settimeout(None)
    refresh()
